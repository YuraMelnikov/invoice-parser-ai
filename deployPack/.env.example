# ============================================================
# deployPack: шаблон переменных окружения.
# Скопировать в .env (в корне deployPack) и заполнить значения.
# .env НЕ коммитить — секреты.
# ============================================================

# --- Postgres (внутренняя БД пайплайна) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=invoices

# --- n8n ---
# Сгенерировать случайные строки (например: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_USER_MANAGEMENT_JWT_SECRET=CHANGE_ME

# --- SMB-шара с приходными накладными ---
# Путь к шаре задан в docker-compose.yml (volume docs_ai) —
# при другом адресе шары поправить device там.
SMB_USER=CHANGE_ME
SMB_PASS=CHANGE_ME

# --- pgAdmin (опционально, есть дефолты) ---
PGADMIN_EMAIL=admin@katek.local
PGADMIN_PASSWORD=CHANGE_ME

# --- Ollama (опционально) ---
# Дефолт: ollama:11434 (внутри docker-сети katek_lab)
#OLLAMA_HOST=ollama:11434
